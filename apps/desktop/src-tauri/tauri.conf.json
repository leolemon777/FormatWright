{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anole",
  "version": "0.1.0",
  "identifier": "local.formatwright.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anole",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Anole Contributors",
    "category": "Utility",
    "shortDescription": "Private, offline-first file conversion",
    "longDescription": "Anole plans, executes, and validates local file conversions with durable jobs and explicit loss policies.",
    "licenseFile": "../../../LICENSE",
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklEZERPVVkwUXpBeFJUVTFSRFUwTWtJS1VsZFJjbFpHTTJ4QlZYbG1aa1ZoUVU5MFYwcFhiRVZqVFVaQ2RsWm9hSFoxT1U5R2RUVkZkMGxGYUhGbWVtaElVM00xTWs1QlJXMEs=",
      "endpoints": [
        "https://github.com/leolemon777/FormatWright/releases/latest/download/latest.json"
      ]
    }
  }
}

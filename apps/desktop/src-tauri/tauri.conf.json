{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormatWright",
  "version": "0.1.0",
  "identifier": "local.formatwright.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FormatWright",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FormatWright Contributors",
    "category": "Utility",
    "shortDescription": "Private, offline-first file conversion",
    "longDescription": "FormatWright plans, executes, and validates local file conversions with durable jobs and explicit loss policies.",
    "licenseFile": "../../../LICENSE",
    "useLocalToolsDir": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:formatwright:schema:probe:v1",
  "title": "FormatWright Probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "format",
    "streams",
    "metadata",
    "warnings",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_path",
        "canonical_path",
        "size_bytes",
        "modified_unix_ms",
        "fast_fingerprint",
        "full_blake3"
      ],
      "properties": {
        "display_path": { "type": "string" },
        "canonical_path": { "type": ["string", "null"] },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "modified_unix_ms": { "type": "integer" },
        "fast_fingerprint": { "type": ["string", "null"] },
        "full_blake3": { "type": ["string", "null"] }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["image", "video", "audio", "document", "pdf", "data", "archive", "unknown"]
        },
        "mime_type": { "type": ["string", "null"] },
        "container": { "type": ["string", "null"] },
        "extension_matches": { "type": ["boolean", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "kind", "properties"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "kind": {
            "enum": ["video", "audio", "subtitle", "attachment", "data", "page", "record-set", "unknown"]
          },
          "codec": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
          "width": { "type": ["integer", "null"], "minimum": 0 },
          "height": { "type": ["integer", "null"], "minimum": 0 },
          "frame_rate": { "type": ["string", "null"] },
          "sample_rate": { "type": ["integer", "null"], "minimum": 0 },
          "channels": { "type": ["integer", "null"], "minimum": 0 },
          "properties": { "type": "object" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "classification"],
        "properties": {
          "value": {},
          "classification": {
            "enum": ["public", "private", "secret", "unknown"]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "engine_version"],
      "properties": {
        "engine_id": { "type": "string" },
        "engine_version": { "type": "string" },
        "engine_binary_sha256": { "type": ["string", "null"] },
        "raw_reference": { "type": ["string", "null"] }
      }
    },
    "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
    "bit_rate": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" }
      }
    }
  }
}

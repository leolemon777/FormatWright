  "$id": "urn:formatwright:schema:application-settings:v1",
  "title": "Anole Application Settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "expert_mode"],
  "properties": {
    "schema_version": { "const": 1 },
    "language": { "enum": ["en", "zh-CN"] },
